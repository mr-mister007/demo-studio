{
  "manifest_version": 3,
  "name": "DemoStudio — Interactive Demo Overlay",
  "version": "1.0.0",
  "description": "Injects a config-driven interactive demo overlay into any page. Edit demo-config.js to change the demo.",
  "permissions": ["storage", "activeTab"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["demo-config.js", "demo-engine.js"],
      "css": ["demo-engine.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "demostudio@example.invalid"
    }
  }
}